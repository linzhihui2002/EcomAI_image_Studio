# ============================================================
# EcomAI Studio - Docker 部署环境变量模板
# ------------------------------------------------------------
# 使用方式：复制为根目录 .env 后按需修改
#   cp .env.docker.example .env
#
# 说明：
# - 该文件同时用于 docker-compose 变量插值 与 后端/Worker 容器环境注入
# - 容器之间的连接地址（MYSQL_HOST / REDIS_URL）已由 docker-compose.yml 固定，
#   无需在此配置
# - 生产环境务必更换所有密钥与账号密码
# ============================================================

# ---------- 镜像与端口 ----------
# 镜像标签：发版时递增，便于回滚（如 20260918-1）
IMAGE_TAG=latest
# 前端对外端口（浏览器访问入口）
FRONTEND_PORT=8080
# MySQL / Redis 映射到宿主机回环地址的端口（仅本机可访问，便于运维排障）
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380

# ---------- MySQL ----------
# 必填：请替换为强随机密码，compose 未提供默认值
MYSQL_ROOT_PASSWORD=change-me-strong-db-password
MYSQL_DATABASE=ecomai_auth

# ---------- Redis ----------
# 任务状态保留时长（秒），默认 1 天
TASK_RESULT_TTL=86400

# ---------- Flask 基础配置 ----------
# 生产环境保持 production（关闭 debug）
FLASK_ENV=production
SECRET_KEY=change-me-flask-secret
JWT_SECRET_KEY=change-me-jwt-secret

# 邀请码 / 用户自备模型 API Key 的 AES 加密密钥，二者必须不同
INVITE_CODE_ENCRYPTION_KEY=change-me-invite-aes-key
USER_AI_KEY_ENCRYPTION_KEY=change-me-user-ai-aes-key

# CORS 允许来源：同域部署（nginx 代理 /api）保持默认即可；
# 若前端与后端分属不同域名，改为具体域名，逗号分隔
CORS_ALLOWED_ORIGINS=*

# 每 IP 每分钟请求上限
RATE_LIMIT_PER_MINUTE=200

# 位于反向代理（nginx）之后时置为 true，用于还原真实客户端 IP，
# 否则全局限流会退化为所有用户共享同一配额
TRUST_PROXY_HEADERS=true

# ---------- Gunicorn 进程/线程 ----------
# 并发 SSE 长连接数 ≈ GUNICORN_WORKERS × GUNICORN_THREADS
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=600
GUNICORN_LOG_LEVEL=info

# ---------- AI 模型配置 ----------
# 三类服务均需为 OpenAI 兼容协议，请填写你自己的服务商地址与密钥
# LLM 文本模型（多语言文案、提示词优化等）
LLM_MODEL_NAME=<your-llm-model>
LLM_API_BASE=<your-openai-compatible-base-url>
LLM_API_KEY=sk-replace-with-your-llm-api-key

# 多模态模型（图片理解、合规审查）
MULTIMODAL_MODEL_NAME=<your-multimodal-model>
MULTIMODAL_API_BASE=<your-openai-compatible-base-url>
MULTIMODAL_API_KEY=sk-replace-with-your-multimodal-api-key

# 图像生成 / 编辑模型
IMAGE_GEN_MODEL_NAME=<your-image-model>
IMAGE_GEN_API_BASE=<your-openai-compatible-base-url>
IMAGE_GEN_API_KEY=sk-replace-with-your-image-api-key
IMAGE_GEN_MAX_RETRIES=2
IMAGE_GEN_TIMEOUT=300

# MinerU 文档解析 Token（生图计划分析功能需要）
MINERU_TOKEN=

# 批量链路生成后自动执行视觉合规审查
COMPLIANCE_REVIEW_ENABLED=true
