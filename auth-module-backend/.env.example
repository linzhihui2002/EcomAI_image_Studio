# ==========================================
# EcomAI Studio Auth Module - 环境变量模板
# ==========================================
# 使用方式：
#   cp .env.example .env
# 然后按下述说明填写实际值。.env 已被 .gitignore 排除，不会提交到仓库。
#
# 安全约定：
# - 本文件仅包含占位符，请勿在此填入任何真实密钥后提交
# - 生产环境请使用强随机值，四个密钥必须互不相同
# - 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"

# ==========================================
# Flask 配置
# ==========================================
# 运行环境：development / production / testing / default
FLASK_ENV=development
SECRET_KEY=change-me-flask-secret

# ==========================================
# MySQL 数据库配置
# ==========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me-db-password
MYSQL_DATABASE=ecomai_auth

# ==========================================
# JWT 配置
# ==========================================
JWT_SECRET_KEY=change-me-jwt-secret

# ==========================================
# 加密密钥（AES-256-CBC）
# ==========================================
# 团队邀请码加密密钥
INVITE_CODE_ENCRYPTION_KEY=change-me-invite-aes-key

# 用户自备模型 API Key 加密密钥（BYOK）
# 用于加密用户在平台填写的第三方模型 API Key，必须独立于邀请码密钥
# 注意：该密钥一经使用不可随意更换，否则存量用户 API Key 将无法解密
USER_AI_KEY_ENCRYPTION_KEY=change-me-user-ai-aes-key

# ==========================================
# 邮件服务配置（SMTP，用于发送验证码）
# ==========================================
# 不配置时，注册与验证码登录会失败，密码登录不受影响
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
# 发件邮箱
SMTP_USERNAME=
# 邮箱授权码（不是登录密码）
SMTP_PASSWORD=
SMTP_FROM_NAME=EcomAI Studio

# ==========================================
# AI 模型配置（均为 OpenAI 兼容协议）
# ==========================================

# LLM 文本模型配置（文案生成、提示词方案、Agent 规划）
LLM_MODEL_NAME=
LLM_API_BASE=
LLM_API_KEY=
LLM_MAX_RETRIES=2

# 多模态模型配置（图片理解、合规审查、反推提示词）
MULTIMODAL_MODEL_NAME=
MULTIMODAL_API_BASE=
MULTIMODAL_API_KEY=
MULTIMODAL_TIMEOUT=300
MULTIMODAL_MAX_RETRIES=2

# 图像生成模型配置（AI 图片编辑器的 AI 工具复用同一通道：POST /images/edits，
# 读取模型名/地址/密钥/超时/重试即下方 IMAGE_GEN_* 各键）
IMAGE_GEN_MODEL_NAME=
IMAGE_GEN_API_BASE=
IMAGE_GEN_API_KEY=
IMAGE_GEN_MAX_RETRIES=2
IMAGE_GEN_TIMEOUT=300

# MinerU 文档解析 Token（生图计划分析功能上传 PDF/Word/PPT/Excel 时需要）
MINERU_TOKEN=

# ==========================================
# Redis / 异步任务队列
# ==========================================
REDIS_URL=redis://localhost:6379/0
# 任务状态保留时长（秒），默认 1 天
TASK_RESULT_TTL=86400

# ==========================================
# 可选调优项
# ==========================================
# 生图计划分析结果缓存秒数
ANALYSIS_CACHE_TTL=3600
# 单文件上传上限（字节，默认 50MB）
FILE_UPLOAD_MAX_SIZE=52428800
# 分块上传分片大小（字节，默认 5MB）
CHUNK_SIZE=5242880
# 批量链路生成后自动执行视觉合规审查
COMPLIANCE_REVIEW_ENABLED=true
