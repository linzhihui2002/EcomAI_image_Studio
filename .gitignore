# ============================================================
# EcomAI_image_Studio - Git 忽略规则
# ============================================================

# ---------- 环境变量与密钥（务必保留，避免密钥入库） ----------
.env
.env.*
!.env.example
!.env.docker.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# ---------- 前端 ----------
node_modules/
dist/
.vite/
*.tsbuildinfo

# ---------- 运行时数据（可能含用户素材与请求内容） ----------
uploads/
auth-module-backend/uploads/
*.log
dump.rdb

# ---------- 测试与临时产物 ----------
after_pytest_task*.txt
baseline_pytest_task*.txt
auth-module-backend/tmp_e2e_*.py
*.bak

# ---------- 本地开发与调研产物（与项目功能无关） ----------
prototype/
.trae/

# ---------- 私钥与证书（严禁入库） ----------
*.pem
*.key
*.p12
*.pfx
*.ppk
*.crt
id_rsa*

# ---------- 编辑器与系统文件 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
